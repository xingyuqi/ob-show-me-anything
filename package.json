{
	"name": "ob-show-me-anything",
	"version": "1.4.0",
	"description": "Preview Word, PowerPoint, and Excel files in Obsidian.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint main.ts",
		"check": "npm run lint && npm run build",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"deploy": "npm run build && powershell -ExecutionPolicy Bypass -File deploy.ps1",
		"deploy-bat": "npm run build && deploy.bat"
	},
	"keywords": [
		"obsidian",
		"office",
		"preview"
	],
	"author": "xingyuqi",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^16.11.6",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"builtin-modules": "3.3.0",
		"esbuild": "0.17.3",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "4.7.4"
	},
	"dependencies": {
		"docx-preview": "^0.3.6",
		"pptx-preview": "^1.0.7",
		"xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
	},
	"overrides": {
		"lodash": "4.18.1"
	}
}
