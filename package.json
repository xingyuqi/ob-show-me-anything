{
	"name": "ob-show-me-anything",
	"version": "2.0.1",
	"description": "Local PDF and Office previews with basic document editing for Obsidian.",
	"main": "main.js",
	"repository": {
		"type": "git",
		"url": "https://github.com/xingyuqi/ob-show-me-anything.git"
	},
	"bugs": {
		"url": "https://github.com/xingyuqi/ob-show-me-anything/issues"
	},
	"homepage": "https://github.com/xingyuqi/ob-show-me-anything#readme",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc && node esbuild.config.mjs production",
		"lint": "eslint --ext .ts --ignore-pattern \"*.d.ts\" .",
		"check": "npm run lint && npm run build",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"deploy": "npm run build && node deploy.mjs",
		"release:prepare": "npm run check && node sync-release.mjs"
	},
	"keywords": [
		"obsidian",
		"office",
		"preview"
	],
	"author": "xingyuqi",
	"license": "0BSD",
	"devDependencies": {
		"@types/node": "20.19.43",
		"@typescript-eslint/eslint-plugin": "8.69.0",
		"@typescript-eslint/parser": "8.69.0",
		"builtin-modules": "5.3.0",
		"esbuild": "0.28.2",
		"eslint": "8.57.1",
		"obsidian": "1.13.1",
		"tslib": "2.8.1",
		"typescript": "5.9.3"
	},
	"dependencies": {
		"docx-preview": "0.4.0",
		"jszip": "3.10.1",
		"pdfjs-dist": "4.10.38",
		"pptx-preview": "1.0.7",
		"xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
	},
	"overrides": {
		"echarts": "6.1.0",
		"lodash": "4.18.1",
		"uuid": "11.1.1"
	}
}
