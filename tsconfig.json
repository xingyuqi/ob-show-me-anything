{
	"compilerOptions": {
		"baseUrl": ".",
		"forceConsistentCasingInFileNames": true,
		"importHelpers": true,
		"inlineSourceMap": true,
		"inlineSources": true,
		"isolatedModules": true,
		"lib": ["DOM", "ES2018"],
		"module": "ESNext",
		"moduleResolution": "node",
		"noEmit": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2018"
	},
	"include": ["**/*.ts"]
}
